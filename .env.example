# ---------------------------------------------------------------------------
# FitFlow environment configuration
# Copy this file to .env.local and fill in real values. Never commit .env.local.
# ---------------------------------------------------------------------------

# MongoDB connection string. REQUIRED.
#
# Production: a MongoDB Atlas SRV string, e.g.
#   mongodb+srv://<user>:<password>@<cluster>.mongodb.net/fitflow?retryWrites=true&w=majority
#
# Local development: run `npm run db:dev` in a second terminal and use
#   mongodb://127.0.0.1:27017/fitflow
MONGODB_URI=

# Secret used to sign session cookies. REQUIRED. At least 32 characters.
# Generate one with:  openssl rand -base64 48
AUTH_SECRET=

# Public origin of the deployed app. Used for absolute URLs and cookie scoping.
# Local:      http://localhost:3000
# Production: https://your-app.onrender.com
NEXT_PUBLIC_APP_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Optional: used only by `npm run seed:admin` to bootstrap the staff account.
# There is no public sign-up route, so this is how the first login is created.
# Remove these after the account exists.
# ---------------------------------------------------------------------------
SEED_ADMIN_NAME=Owner
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
